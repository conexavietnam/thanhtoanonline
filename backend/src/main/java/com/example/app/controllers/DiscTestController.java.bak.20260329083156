package com.example.app.controllers;

import com.example.app.dto.request.DiscTestSubmitRequest;
import com.example.app.dto.response.DiscTestHistoryItemResponse;
import com.example.app.dto.response.DiscTestResultResponse;
import com.example.app.dto.response.QuestionItemResponse;
import com.example.app.services.DiscTestService;
import jakarta.validation.Valid;
import java.util.List;
import lombok.RequiredArgsConstructor;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.security.core.Authentication;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/disc")
@RequiredArgsConstructor
public class DiscTestController {
  private final DiscTestService discTestService;

  @GetMapping("/questions")
  public List<QuestionItemResponse> questions(
      @RequestParam(value = "mode", required = false) String mode) {
    return discTestService.loadQuestions(mode);
  }

  @PostMapping("/tests")
  public DiscTestResultResponse submit(
      Authentication authentication,
      @Valid @RequestBody DiscTestSubmitRequest request) {
    return discTestService.submit(request, authentication);
  }

  @GetMapping("/tests/history")
  @PreAuthorize("isAuthenticated()")
  public List<DiscTestHistoryItemResponse> history(Authentication authentication) {
    return discTestService.history(authentication.getName());
  }

  @GetMapping("/tests/latest")
  @PreAuthorize("isAuthenticated()")
  public DiscTestResultResponse latest(Authentication authentication) {
    return discTestService.latest(authentication.getName());
  }
}
