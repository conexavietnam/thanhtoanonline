import { NavLink, Outlet, useNavigate, useLocation } from "react-router";
import { useAuth } from "../../context/AuthContext";
import { useBranding } from "../../context/BrandingContext";
import { useSettings } from "../../context/SettingsContext";

const DISC_SUB_ITEMS = [
  { to: "/admin/questions", label: "Câu hỏi", emoji: "📋" },
  { to: "/admin/insights", label: "Insights", emoji: "🔮" },
  { to: "/admin/careers", label: "Nghề nghiệp", emoji: "💼" },
  { to: "/admin/development-plans", label: "Lộ trình", emoji: "🗺️" },
];

const DISC_PATHS = DISC_SUB_ITEMS.map((item) => item.to);

// All available menu items
const allMenuItems = [
  { to: "/admin", label: "Dashboard", end: true, icon: "📊", roles: ['SUPER_ADMIN', 'CONTENT_ADMIN', 'FINANCE_ADMIN', 'SUPPORT_ADMIN'] },
  { to: "/admin/users", label: "Quản lý Users", icon: "👥", roles: ['SUPER_ADMIN', 'SUPPORT_ADMIN'] },
  { to: "/admin/plans/user", label: "Gói User", icon: "👤", roles: ['SUPER_ADMIN', 'FINANCE_ADMIN'] },
  { to: "/admin/plans/partner", label: "Gói Partner", icon: "👔", roles: ['SUPER_ADMIN', 'FINANCE_ADMIN'] },
  {
    to: "/admin/questions",
    label: "Quản lý DISC",
    icon: "🧠",
    roles: ['SUPER_ADMIN', 'CONTENT_ADMIN'],
    activePaths: DISC_PATHS,
    hasSubMenu: true,
  },
  { to: "/admin/finance", label: "Quản lý Tài chính", icon: "💰", roles: ['SUPER_ADMIN', 'FINANCE_ADMIN', 'SUPPORT_ADMIN'] },
  { to: "/admin/referrals", label: "Referrals", icon: "🤝", roles: ['SUPER_ADMIN', 'FINANCE_ADMIN'] },
  { to: "/admin/audit-logs", label: "Audit Logs", icon: "📋", roles: ['SUPER_ADMIN'] },
  { to: "/admin/settings", label: "Cài đặt", icon: "⚙️", roles: ['SUPER_ADMIN'] },
];

const AdminLayout = () => {
  const { user, logout } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();
  const { customization } = useBranding();
  const { settings, theme, toggleTheme } = useSettings();

  // ALWAYS show all menu items regardless of roles
  const currentMenu = allMenuItems;

  // Check if currently in a DISC page to control sub-menu visibility
  const isInDiscSection = DISC_PATHS.some((path) =>
    location.pathname.startsWith(path)
  );

  // Get logo and brand name
  const logoUrl = customization?.logoUrl || settings?.logoUrl || "/logo.png";
  const brandName = customization?.brandName || settings?.siteName || "DISC Admin";

  const handleLogout = () => {
    logout();
    navigate('/login');
  };

  const handleBackToDashboard = () => {
    navigate('/');
  };

  // Sidebar Content Component (reusable)
  const SidebarContent = () => (
    <>
      {/* Header */}
      <div className="flex items-center justify-between h-20 px-6 border-b border-base-200/50">
        <div className="flex items-center gap-3">
          <img
            src={logoUrl}
            alt={brandName}
            className="h-10 w-auto object-contain max-w-[120px]"
          />
          <div>
            <h1 className="text-lg font-bold text-base-content leading-tight">{brandName}</h1>
            <p className="text-[10px] text-base-content/70 font-bold uppercase tracking-widest">Workspace</p>
          </div>
        </div>

        {/* Theme Toggle */}
        <button
          onClick={toggleTheme}
          className="btn btn-circle btn-sm btn-ghost text-base-content/60 hover:text-primary hover:bg-base-200 transition-all"
          title={theme === 'dark' ? 'Switch to Light Mode' : 'Switch to Dark Mode'}
        >
          {theme === 'dark' ? '☀️' : '🌙'}
        </button>
      </div>

      {/* User Info */}
      <div className="px-4 py-4">
        <div className="flex items-center gap-3 p-3 rounded-2xl bg-base-100 border border-base-200/60 shadow-sm hover:shadow-md transition-all cursor-pointer group">
          <div className="avatar placeholder">
            <div className="bg-gradient-to-br from-primary to-secondary text-white rounded-xl w-10 h-10 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform duration-300">
              <span className="text-lg font-bold">
                {(user?.fullName || user?.email || 'A')[0].toUpperCase()}
              </span>
            </div>
          </div>
          <div className="flex-1 min-w-0">
            <p className="font-semibold text-base-content truncate text-sm group-hover:text-primary transition-colors">
              {user?.fullName || user?.email || 'Administrator'}
            </p>
            <div className="flex flex-wrap gap-1 mt-0.5">
              <span className="badge badge-xs badge-success badge-subtle">Online</span>
            </div>
          </div>
        </div>
      </div>

      {/* Menu */}
      <nav className="flex-1 overflow-y-auto px-4 py-2 space-y-1 custom-scrollbar">
        <p className="px-4 text-[10px] font-bold uppercase text-base-content/80 tracking-wider mb-2">Menu</p>

        {currentMenu.map((item) => {
          const isActuallyActive = location.pathname === item.to
            || (item.end === false && location.pathname.startsWith(item.to))
            || (item.activePaths && item.activePaths.some(path => location.pathname.startsWith(path)));

          return (
            <div key={item.to}>
              <NavLink
                to={item.to}
                end={item.end}
                className={() => {
                  return `flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all duration-200 group relative overflow-hidden ${isActuallyActive
                    ? "bg-primary text-white shadow-lg shadow-primary/30"
                    : "text-base-content/80 hover:bg-base-100 hover:text-base-content"
                    }`;
                }}
              >
                {isActuallyActive && (
                  <div className="absolute inset-0 bg-gradient-to-r from-white/20 to-transparent opacity-30" />
                )}
                <span className={`text-xl flex-shrink-0 transition-transform duration-300 ${isActuallyActive ? 'scale-110' : 'group-hover:scale-110 opacity-70'}`}>
                  {item.icon}
                </span>
                <span className="flex-1 relative z-10">{item.label}</span>
                {isActuallyActive && (
                  <span className="w-1.5 h-1.5 rounded-full bg-white shadow-sm" />
                )}
              </NavLink>

              {/* DISC Sub-menu — only shows when in DISC section */}
              {item.hasSubMenu && isInDiscSection && (
                <div className="mt-1 ml-4 space-y-0.5 border-l-2 border-primary/20 pl-3">
                  {DISC_SUB_ITEMS.map((sub) => {
                    const isSubActive = location.pathname.startsWith(sub.to);
                    return (
                      <NavLink
                        key={sub.to}
                        to={sub.to}
                        className={`flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium transition-all ${isSubActive
                            ? "bg-primary/10 text-primary font-semibold"
                            : "text-base-content/60 hover:bg-base-100 hover:text-base-content"
                          }`}
                      >
                        <span className="text-sm">{sub.emoji}</span>
                        <span>{sub.label}</span>
                      </NavLink>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })}
      </nav>

      {/* Footer */}
      <div className="p-4 border-t border-base-200/50 space-y-2">
        <button
          onClick={handleBackToDashboard}
          className="btn btn-sm btn-ghost w-full justify-start gap-3 font-normal text-base-content/80 hover:text-primary hover:bg-primary/5 rounded-xl transition-all"
        >
          <span>🏠</span>
          <span>Về trang chủ khách</span>
        </button>
        <button
          onClick={handleLogout}
          className="btn btn-sm btn-ghost w-full justify-start gap-3 font-normal text-error hover:bg-error/10 rounded-xl transition-all"
        >
          <span>🚪</span>
          <span>Đăng xuất hệ thống</span>
        </button>
      </div>
    </>
  );

  return (
    <div className="min-h-screen font-sans selection:bg-primary/20 text-base-content">
      {/* Background Decoration */}
      <div className="fixed inset-0 pointer-events-none z-0">
        <div className="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] rounded-full bg-primary/5 blur-[100px]" />
        <div className="absolute bottom-[-10%] left-[-5%] w-[500px] h-[500px] rounded-full bg-secondary/5 blur-[100px]" />
      </div>

      {/* Desktop Layout */}
      <div className="hidden lg:flex min-h-screen relative z-10">
        {/* Sidebar - Floating Style */}
        <aside className="fixed inset-y-4 left-4 z-50 w-72 rounded-3xl bg-base-100/90 backdrop-blur-xl border border-base-200 shadow-2xl shadow-base-200/50 flex flex-col">
          <SidebarContent />
        </aside>

        {/* Main Content - Desktop */}
        <div className="flex-1 w-full ml-80">
          <div className="min-h-screen py-8 pr-8 pl-0">
            <div className="bg-base-100/50 backdrop-blur-md rounded-[2.5rem] border border-base-content/5 shadow-sm min-h-[calc(100vh-4rem)] p-8 animate-fade-in-up">
              <Outlet />
            </div>
          </div>
        </div>
      </div>

      {/* Mobile Layout */}
      <div className="drawer lg:hidden relative z-10">
        <input id="admin-drawer" type="checkbox" className="drawer-toggle" />
        <div className="drawer-content flex flex-col min-h-screen">
          {/* Mobile Navbar */}
          <div className="w-full navbar bg-base-100/90 backdrop-blur-lg border-b border-base-200 sticky top-0 z-30 px-4 shadow-sm">
            <div className="flex-none">
              <label htmlFor="admin-drawer" className="btn btn-square btn-ghost btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" className="inline-block w-5 h-5 stroke-current">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
              </label>
            </div>
            <div className="flex-1 px-2 mx-2 font-bold text-base-content flex items-center gap-2">
              {/* Mobile Logo */}
              {logoUrl ? (
                <img src={logoUrl} alt={brandName} className="h-8 w-auto" />
              ) : (
                <span className="text-2xl">🛡️</span>
              )}
            </div>
            <div className="flex-none">
              <div className="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xs ring-2 ring-white shadow-sm">
                {(user?.fullName || 'A')[0].toUpperCase()}
              </div>
            </div>
          </div>

          {/* Mobile Content */}
          <div className="flex-1 p-4">
            <Outlet />
          </div>
        </div>

        {/* Mobile Sidebar Drawer */}
        <div className="drawer-side z-50">
          <label htmlFor="admin-drawer" aria-label="close sidebar" className="drawer-overlay bg-base-content/10 backdrop-blur-sm"></label>
          <aside className="bg-base-100 w-80 min-h-full flex flex-col p-4">
            <div className="relative flex-1 flex flex-col bg-base-100 rounded-2xl shadow-xl overflow-hidden border border-base-200">
              <SidebarContent />
            </div>
          </aside>
        </div>
      </div>
    </div>
  );
};

export default AdminLayout;
