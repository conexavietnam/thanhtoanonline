            title="Big Five"
            type="bigFive"
            items={showBigFiveCard ? bigFiveScores : []}
            palettes={["#0ea5e9", "#fbbf24", "#8b5cf6", "#10b981", "#f43f5e"]}
            emptyTitle={isFreePreviewResult ? "Big Five chưa mở ở bản hiện tại" : "Chưa có dữ liệu Big Five"}
            emptyDescription={
              isFreePreviewResult
                ? "Kết quả miễn phí hiện chỉ hiển thị DISC. Hãy mở bài test trả phí để xem đầy đủ nhóm chỉ số Big Five."
                : "Kết quả hiện tại chưa có đủ dữ liệu để hiển thị nhóm chỉ số Big Five."
            }
            action={
              traitActionTarget && traitActionLabel ? (
                <Link to={traitActionTarget} className="btn btn-primary btn-sm">
                  {traitActionLabel}
                </Link>
              ) : null
            }
          />

          <TraitScoreCard
            title="IKIGAI"
            type="ikigai"
            items={showIkigaiCard ? ikigaiScores : []}
            palettes={["#2563eb", "#16a34a", "#ea580c", "#0891b2"]}
            emptyTitle={isFreePreviewResult ? "IKIGAI chưa mở ở bản hiện tại" : "Chưa có dữ liệu IKIGAI"}
            emptyDescription={
              isFreePreviewResult
                ? "Bản kết quả hiện tại chưa có các trục động lực và định hướng nghề nghiệp của IKIGAI."
                : "Kết quả hiện tại chưa có đủ dữ liệu để hiển thị nhóm chỉ số IKIGAI."
            }
