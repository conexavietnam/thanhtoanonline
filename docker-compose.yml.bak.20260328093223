services:
  db:
    image: postgres:16-alpine
    container_name: disccuong-postgres
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-appdb}
      POSTGRES_USER: ${POSTGRES_USER:-appuser}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-apppass}
    volumes:
      - db_data:/var/lib/postgresql/data
    ports:
      - "${POSTGRES_PORT:-5433}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER:-appuser} -d $${POSTGRES_DB:-appdb}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    restart: unless-stopped

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: disccuong-backend
    depends_on:
      db:
        condition: service_healthy
    environment:
      # Use the explicit container name because network alias "db" is not created when container_name is set
      DB_URL: jdbc:postgresql://disccuong-postgres:5432/${POSTGRES_DB:-appdb}
      DB_USER: ${POSTGRES_USER:-appuser}
      DB_PASSWORD: ${POSTGRES_PASSWORD:-apppass}
      JWT_SECRET: ${JWT_SECRET:-change-me-change-me-change-me-32}
      JWT_EXPIRATION_MS: ${JWT_EXPIRATION_MS:-86400000}
      JWT_REFRESH_EXPIRATION_MS: ${JWT_REFRESH_EXPIRATION_MS:-1209600000}
      JWT_ISSUER: ${JWT_ISSUER:-disccuong-app}
      APP_BASE_URL: ${APP_BASE_URL:-http://localhost:5174}
      AUTH_VERIFY_EXPIRE_MIN: ${AUTH_VERIFY_EXPIRE_MIN:-1440}
      AUTH_RESET_EXPIRE_MIN: ${AUTH_RESET_EXPIRE_MIN:-60}
      TELEGRAM_ENABLED: ${TELEGRAM_ENABLED:-false}
      TELEGRAM_BOT_TOKEN: ${TELEGRAM_BOT_TOKEN:-}
      TELEGRAM_CHAT_ID: ${TELEGRAM_CHAT_ID:-}
      GOOGLE_OAUTH_CLIENT_ID: ${GOOGLE_OAUTH_CLIENT_ID:-}
      GOOGLE_OAUTH_CLIENT_SECRET: ${GOOGLE_OAUTH_CLIENT_SECRET:-}
      GOOGLE_OAUTH_CLIENT_IDS: ${GOOGLE_OAUTH_CLIENT_IDS:-}
      MAIL_HOST: ${MAIL_HOST:-}
      MAIL_PORT: ${MAIL_PORT:-587}
      MAIL_USERNAME: ${MAIL_USERNAME:-}
      MAIL_PASSWORD: ${MAIL_PASSWORD:-}
      MAIL_SMTP_AUTH: ${MAIL_SMTP_AUTH:-true}
      MAIL_SMTP_STARTTLS_ENABLE: ${MAIL_SMTP_STARTTLS_ENABLE:-true}
      APP_MAIL_FROM: ${APP_MAIL_FROM:-no-reply@disc.local}
      SERVER_PORT: 8083
    ports:
      - "8083:8083"
    restart: unless-stopped

  frontend:
    build:
      context: ./discfe
      dockerfile: Dockerfile
      args:
        VITE_API_BASE_URL: ${VITE_API_BASE_URL:-/api}
    container_name: disccuong-frontend
    depends_on:
      - backend
    ports:
      - "${FRONTEND_PORT:-5174}:80"
    restart: unless-stopped

volumes:
  db_data:
    driver: local
